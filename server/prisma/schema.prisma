datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id            String    @id @default(cuid())
  slug          String    @unique // ex: "shopee", "empresa_b"
  name          String    // ex: "Shopee SP", "Operação Logística B"
  adminPassword String    @default("admin123") // Senha de administrador para exclusão e alterações
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tickets       Ticket[]
  users         User[]
}

model User {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username           String
  name               String
  passwordHash       String
  role               String
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, username])
  @@index([tenantId, role])
}

model Ticket {
  id              String         @id @default(cuid())
  tenantId        String         @default("shopee_default")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  protocol        String         @unique
  employeeName    String
  employeeId      String         // Matrícula
  workplace       String         // Nome do Posto de trabalho
  workplaceCode   String?        // Código do Hub (ex: HUB-LSP-02)
  workplaceRegion String?        // Região (ex: Capital, Campinas, etc.)
  benefitType     String         // VR, VT, SAUDE, UNIFORME, MULTIPLOS, OUTRO
  priority        String         @default("MEDIA") // BAIXA, MEDIA, ALTA, CRITICA
  status          String         @default("NOVO") // NOVO, EM_ANALISE, AGUARDANDO_FORNECEDOR, EM_TRATATIVA, RESOLVIDO, CANCELADO
  description     String         // Relato original
  summary         String         // Resumo gerado pela IA
  missingInfo     String?        // Se a IA detectou algo faltando
  telegramChatId  String?        // ID do chat para responder ao funcionário
  telegramMsgId   String?
  slaHours        Int            @default(24) // Prazo de SLA em horas
  slaDueAt        DateTime       // Data/hora limite para cumprimento do SLA
  firstResponseAt DateTime?      // Data/hora da primeira tratativa
  resolvedAt      DateTime?      // Data/hora de resolução
  slaStatus       String         @default("DENTRO_PRAZO") // DENTRO_PRAZO, ALERTA, ESTOURADO, CUMPRIDO, DESCUMPRIDO
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  treatments      TreatmentLog[]
}

model TreatmentLog {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      String   @default("Operador")
  action      String   // ex: MUDANCA_STATUS, NOTA_INTERNA, RESPOSTA_TELEGRAM, EXCLUSAO_TENTATIVA
  notes       String
  prevStatus  String?
  newStatus   String?
  createdAt   DateTime @default(now())
}

model Setting {
  id          String   @id @default("system_config")
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}
